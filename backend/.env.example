# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Replace YOUR_USERNAME, YOUR_PASSWORD, and YOUR_CLUSTER with your actual MongoDB Atlas cluster credentials.
# Ensure the database name 'mcq_generator' is specified before the query parameters.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/mcq_generator?retryWrites=true&w=majority

# Frontend Client URL for CORS
FRONTEND_URL=http://localhost:5173

# Environment
NODE_ENV=development
